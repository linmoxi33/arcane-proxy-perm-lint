#!/usr/bin/env python3
"""Executable entry point for arcane-proxy-perm-lint.

Keeps the repo-root module importable regardless of where the CLI is invoked from.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from arcane_proxy_perm_lint import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
